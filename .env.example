# BRATVACODER - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# ============================================
# BANCO DE DADOS (Obrigatório)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================
# AUTENTICAÇÃO (Obrigatório)
# ============================================
SESSION_SECRET=sua-chave-secreta-sessao-aqui

# Replit Auth (preenchido automaticamente no Replit)
REPL_ID=seu-repl-id
ISSUER_URL=https://replit.com

# ============================================
# POE.COM API (Obrigatório para geração IA)
# ============================================
# Obtenha em: https://poe.com/api_key
POE_API_KEY=sua-chave-api-poe-aqui

# ============================================
# GITHUB (Opcional - configurado via Replit Connectors)
# ============================================
# A integração GitHub usa Replit Connectors
# Configure via interface do Replit, não precisa de variáveis aqui

# ============================================
# STRIPE (Opcional - para pagamentos)
# ============================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ============================================
# OBJECT STORAGE (Opcional - para armazenar arquivos)
# ============================================
# Usa Replit Object Storage integrado
# Configure no painel "Object Storage" do Replit
# PUBLIC_OBJECT_SEARCH_PATHS=/seu-bucket/public
# PRIVATE_OBJECT_DIR=/seu-bucket/private

# ============================================
# CACHE REDIS (Opcional - para performance)
# ============================================
# Se não configurado, usa cache em memória
# REDIS_URL=redis://user:password@host:port

# ============================================
# LOGGING (Opcional - para monitoramento)
# ============================================
# Se não configurado, usa console padrão
# LOGGLY_TOKEN=seu-token-loggly
# LOG_LEVEL=info

# ============================================
# AMBIENTE
# ============================================
NODE_ENV=development
PORT=5000
